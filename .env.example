# =========================================================================
# OneMap serverless credentials — TEMPLATE
# -------------------------------------------------------------------------
# These power the /api/onemap-token serverless function, which mints fresh
# OneMap tokens automatically so you never paste one by hand again.
#
# Local development:
#   1. Copy this file to ".env.local":   cp .env.example .env.local
#   2. Fill in your real OneMap account email + password below.
#   3. Run "vercel dev" (NOT plain `serve`) so the function runs locally.
#
# Vercel deployment:
#   Do NOT commit real credentials. Instead set them in the project:
#     vercel env add ONEMAP_EMAIL
#     vercel env add ONEMAP_PASSWORD
#   (or via the Vercel dashboard -> Settings -> Environment Variables)
#
# .env.local is git-ignored and .vercelignore'd so it never leaves your machine.
# =========================================================================

ONEMAP_EMAIL=you@example.com
ONEMAP_PASSWORD=your-onemap-password
